{
  "name": "feuillets-dev",
  "version": "2.8.2",
  "description": "Feuillets plugin development",
  "main": "main.js",
  "scripts": {
    "postinstall": "node scripts/patch-script-polyfills.mjs",
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint . && tsc -noEmit -skipLibCheck",
    "lint:obsidian": "eslint --config obsidian-review.config.mjs src",
    "test": "npm run test:compiled",
    "test:direct": "node --test test/*.test.js",
    "test:compiled": "node -e \"require('node:fs').rmSync('.test-dist', { recursive: true, force: true })\" && tsc -p tsconfig.test.json && node scripts/prepare-test-obsidian-stub.mjs && node --test .test-dist/test/*.test.js",
    "test:pagination-baseline": "node scripts/pagination-baseline.mjs",
    "update:pagination-baseline": "node scripts/pagination-baseline.mjs --update"
  },
  "keywords": [],
  "author": "Halim",
  "license": "GPL-3.0",
  "type": "module",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/parser": "^8.65.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "latest",
    "playwright": "1.62.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.6",
    "@dagrejs/dagre": "^3.1.1",
    "@lezer/markdown": "1.6.3",
    "diff": "^9.0.0",
    "docx": "^9.7.1",
    "jszip": "^3.10.1"
  }
}
