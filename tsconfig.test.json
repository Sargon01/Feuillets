    "outDir": ".test-dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "include": ["src/**/*", "test/**/*.js"],
  "exclude": ["node_modules", ".test-dist"]
}
