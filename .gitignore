# pas commités ici — trop lourds pour l'installeur standard d'Obsidian.
/resources/grammalecte/
/resources/harper/
/resources/.grammalecte-version.json
/resources/.harper-version.json

# Mots appris / fautes ignorées de la correction grammaticale — données
