/main.js
/main.js.map

# Editor/OS cruft
*.log
.vscode/

# Sorties de repomix (export du dépôt pour analyse) — régénérables
repomix-output.*

# Moteurs locaux de correction (Grammalecte/Harper) : téléchargés à la
